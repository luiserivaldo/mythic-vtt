{
  "name": "mythic-vtt",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:table": "node scripts/dev-table.mjs",
    "build": "pnpm -r --filter './packages/*' build",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @mythic/e2e test",
    "lint": "eslint . && prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.12.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "@types/node": "^22.0.0",
    "fast-check": "^4.10.2",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
